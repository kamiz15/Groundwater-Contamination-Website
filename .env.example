# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<required-random-secret>
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Security: keep these ON in production (serve over HTTPS). Set SESSION_COOKIE_SECURE=false
# only for plain-HTTP local development, otherwise the login cookie will not be sent.
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
# Panel reads the user identity from the proxy-injected X-Auth-Email header. Leave OFF
# in production; set to true only when running the Panel service standalone without
# the proxy (local development).
PANEL_TRUST_QUERY_EMAIL=false
# Temporary demo switch. Keep false outside local/demo environments.
DEMO_BYPASS_LOGIN=false
DEMO_USER_EMAIL=demo@example.com
DB_HOST=db
DB_PORT=3306
DB_USER=<required-database-user>
DB_PASSWORD=<required-database-password>
DB_NAME=cast_project
MYSQL_ROOT_PASSWORD=<required-compose-root-password>
PANEL_PUBLIC_BASE=http://localhost:5007
PANEL_HOST=0.0.0.0
PANEL_PORT=5007
PANEL_ALLOW_ORIGINS=localhost:5007,127.0.0.1:5007,localhost:5000,127.0.0.1:5000
MF6_EXE=/usr/local/bin/mf6
NUMERICAL_HK_MIN_M_PER_DAY=0.000001
NUMERICAL_HK_MAX_M_PER_DAY=1000
NUMERICAL_MAX_CELLS=40000
NUMERICAL_SOLVER_TIMEOUT_S=120
