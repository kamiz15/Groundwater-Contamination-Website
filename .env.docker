FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# The bundled nginx terminates plain HTTP on port 80, so Secure cookies are off here.
# IMPORTANT: put TLS in front of nginx and set SESSION_COOKIE_SECURE=true before
# exposing this to real users.
SESSION_COOKIE_SECURE=false
# nginx is in front and injects the trusted X-Auth-Email / X-Real-IP headers.
TRUST_PROXY_HEADERS=true
PANEL_TRUST_QUERY_EMAIL=false
# Local visual-verification convenience: auto-authenticate as a demo user so the
# model pages are browsable without login. Set to true only for demo/E2E runs.
DEMO_BYPASS_LOGIN=false
DEMO_USER_EMAIL=demo@example.com
DB_HOST=db
DB_PORT=3306
DB_NAME=cast_project
PANEL_PUBLIC_BASE=/panel
PANEL_HOST=0.0.0.0
PANEL_PORT=5007
# Add the public hostname of each deployment (e.g. cast.uni-tuebingen.de)
# or the Panel iframes will refuse their websocket connections.
PANEL_ALLOW_ORIGINS=localhost,127.0.0.1,localhost:80,127.0.0.1:80
# Installed in the Docker image from the official MODFLOW 6 release archive.
MF6_EXE=/usr/local/bin/mf6
NUMERICAL_HK_MIN_M_PER_DAY=0.000001
NUMERICAL_HK_MAX_M_PER_DAY=1000
NUMERICAL_MAX_CELLS=40000
NUMERICAL_SOLVER_TIMEOUT_S=120
