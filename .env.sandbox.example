# ---------------------------------------------------------------------------
# Sandbox stack: a second, fully isolated copy of the site for experimenting.
#
# HOW TO USE
#   1. Make a separate checkout:  git clone <repo> pacs-sandbox
#   2. cd pacs-sandbox && git switch <the branch you want to try>
#   3. cp .env.sandbox.example .env        (edit the passwords below)
#   4. docker compose up -d --build
#   5. Open http://localhost:8080
#
# That is the whole thing. Because COMPOSE_PROJECT_NAME differs, Docker gives
# this stack its own containers, its own network and its own database and job
# volumes, so nothing it does can reach the live site. Stop it again with
# `docker compose down` (add -v to throw the sandbox database away too).
# ---------------------------------------------------------------------------

# Keeps every container, network and volume separate from the live stack.
COMPOSE_PROJECT_NAME=pacs-sandbox

# The live stack answers on :80; this one answers here. Change it if 8080 is taken.
WEB_PORT=8080

# Shown as a banner on every page so nobody mistakes this for the live site.
SITE_ENV_LABEL=SANDBOX

# --- secrets: sandbox-only values, never reuse the production ones ----------
SECRET_KEY=sandbox-only-not-a-real-secret-change-me
DB_USER=pacs_sandbox
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Note: the database NAME stays whatever .env.docker says. It does not need to
# change - this stack runs its own MySQL container with its own volume, so the
# data is already separate from the live site.
